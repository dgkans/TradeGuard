# TradeGuard environment. Copy to .env and edit. Never commit .env.
# Every process validates this at startup: `uv run python -m services.common.config`

# --- Runtime -----------------------------------------------------------------
# development | test | production
TRADEGUARD_ENV=development
# INFO | DEBUG | WARNING | ERROR
LOG_LEVEL=INFO

# --- Trading safety (startup fails closed if any of these point at live) -----
# replay (simulated broker, default) | paper (Alpaca paper account). "live" is refused.
TRADING_MODE=replay
# Must be false. Any other value stops startup.
LIVE_TRADING=false
# Must be true. Any other value stops startup.
ALPACA_PAPER=true
# Must be exactly the Alpaca paper endpoint. The live endpoint is refused.
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Alpaca paper keys (F11). Leave empty for replay mode.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Symbols the agent watches in an Alpaca paper session (comma separated).
PAPER_WATCHLIST=NVDA,AMD,AAPL,MSFT,TSLA

# --- Approvals (F6) -----------------------------------------------------------
# Escalated calls not approved within this many seconds are auto rejected ("expired").
APPROVAL_TIMEOUT_SECONDS=300
# Approval API (`uv run tradeguard api`). Local only: no authentication until F12.
API_HOST=127.0.0.1
API_PORT=8000
# Owner-only admin login for the dashboard (approvals, audit log, test results). Unset: off.
ADMIN_PASSWORD=
# Signs trader login tokens (F10e). Unset: a new key each start, so traders log in again.
TRADER_TOKEN_SECRET=
# Live prices for the trading desk (F10f): Yahoo Finance, no key. Seconds between polls
# while the market is open, and while it is closed. LIVE_PRICES=false uses replay data.
LIVE_PRICES=true
# yahoo (no key) or finnhub (free key; Yahoo blocks cloud servers like Render's)
LIVE_PRICE_SOURCE=yahoo
FINNHUB_API_KEY=
LIVE_POLL_SECONDS=30
LIVE_CLOSED_POLL_SECONDS=300
# Trace links in the dashboard audit log point here
JAEGER_UI_URL=http://localhost:16686

# --- Database ------------------------------------------------------------------
# Local default matches docker-compose.yml. In production this is the Neon URL.
DATABASE_URL=postgresql://tradeguard:tradeguard@localhost:5432/tradeguard
# Used by docker-compose.yml to create the local database.
POSTGRES_USER=tradeguard
POSTGRES_PASSWORD=tradeguard
POSTGRES_DB=tradeguard

# --- Telemetry -----------------------------------------------------------------
# OTLP/HTTP base URL (/v1/traces is appended). Local Jaeger (`make jaeger`) and the compose
# collector both listen on 4318.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# true turns tracing off entirely (standard OpenTelemetry switch).
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=tradeguard

# --- LLM (free providers only; "anthropic" is refused, see PLAN.md Section 16) -
# ollama | groq | gemini
LLM_PROVIDER=ollama
# Exact model id, pinned per eval run (recorded in DECISIONS.md / RESULTS.md)
LLM_MODEL=qwen3:8b
# Intent alignment judge (F8), same provider. Runs only for ambiguous instructions.
JUDGE_MODEL=qwen3:8b
# Optional smaller model for the quick JSON step (classify the request); empty = LLM_MODEL
LLM_FAST_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Public deployment (F12; see render.yaml). 0 = no cap. --------------------
# AI turns per UTC day for the whole site, and per trader
LLM_DAILY_TURN_CAP=0
TRADER_DAILY_TURN_CAP=0
# Send only the last N user turns to the model in trader chats (0 = all)
TRADER_HISTORY_TURNS=0
SIGNUPS_PER_IP_PER_HOUR=5
# The hosted dashboard's address, comma separated (local dev uses the Vite proxy)
CORS_ORIGINS=
# Trust X-Forwarded-For for the client address (true behind Render's proxy)
TRUST_PROXY=false
